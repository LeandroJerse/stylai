{
  "name": "stylai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=26.13.0 <27",
    "bun": "1.3.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@stylai/web' --filter '@stylai/api' --filter '@stylai/worker' dev",
    "dev:web": "bun run --filter @stylai/web dev",
    "dev:api": "bun run --filter @stylai/api dev",
    "dev:worker": "bun run --filter @stylai/worker dev",
    "dev:catalog": "bun run --filter @stylai/worker dev:catalog",
    "start:catalog": "bun run --filter @stylai/worker start:catalog",
    "build": "bun run build:services && bun run --filter @stylai/web build",
    "build:services": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.services.json && bun run --filter @stylai/web typecheck && tsc --noEmit -p apps/web/tsconfig.node.json",
    "lint": "node scripts/check-boundaries.mjs",
    "test": "bun --conditions=development test apps/web/tests apps/api/tests apps/worker/tests packages scripts/tests",
    "test:web": "bun run --filter @stylai/web test",
    "test:api": "bun --conditions=development test apps/api/tests",
    "test:e2e": "bun run --filter @stylai/web e2e",
    "test:e2e:catalog": "node apps/web/scripts/e2e-affiliate-catalog.mjs",
    "test:e2e:install": "bun run --filter @stylai/web e2e:install",
    "test:smoke": "node scripts/smoke-built.mjs",
    "test:integration": "bun run supabase:check",
    "test:db": "node scripts/test-foundation-db.mjs",
    "test:db:private": "node --conditions=development --import tsx scripts/test-private-db.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run test:smoke",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:check": "node --env-file-if-exists=apps/api/.env.local --conditions=development --import tsx scripts/supabase-check.ts",
    "db:migrate:local": "supabase migration up",
    "db:types": "node --env-file-if-exists=apps/api/.env.local scripts/generate-db-types.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:motor": "node --conditions=development --import tsx scripts/test-motor-slice.ts",
    "check:providers": "node --env-file-if-exists=.env.local --env-file-if-exists=apps/worker/.env.local --conditions=development --import tsx scripts/check-providers.ts",
    "db:dev": "node --conditions=development --import tsx scripts/dev-db.ts",
    "dev:web:demo": "bun run --filter @stylai/web dev:demo",
    "build:web:demo": "bun run --filter @stylai/web build:demo",
    "test:web:demo": "bun run --filter @stylai/web test:demo",
    "test:e2e:official": "node --import tsx scripts/e2e-studio-official.mjs",
    "test:e2e:demo": "bun run --filter @stylai/web e2e:demo",
    "segmind:simulator": "node --import tsx scripts/segmind-simulator.ts",
    "dev:review": "node scripts/dev-review.mjs",
    "dev:review:real": "node scripts/dev-review.mjs --real",
    "pose:analyzer": "uv run tools/pose-validator/analyzer.py serve 54391",
    "catalog:images": "node --import tsx scripts/generate-test-catalog-images.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "supabase": "3.1.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.8.3"
  }
}
