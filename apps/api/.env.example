NODE_ENV=development
SERVICE_HOST=127.0.0.1
API_PORT=3000
APP_ORIGIN=http://localhost:5190
# Hosted foundation: set both in ignored .env.local. Never put server keys in web.
# SUPABASE_URL=https://YOUR_PROJECT_REFERENCE.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# SUPABASE_PROJECT_REF=YOUR_PROJECT_REFERENCE
# Optional elevated capabilities (not needed for the foundation health probe):
# SUPABASE_SECRET_KEY=
# SESSION_ENCRYPTION_KEY=
# SESSION_ENCRYPTION_KEY_VERSION=1
# ASAAS_ENVIRONMENT=sandbox
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_AUTH_TOKEN=
# Payment methods/merchant terms must be confirmed before enabling checkout.
