{
  "name": "@stylai/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview --port 5191 --strictPort",
    "test": "bun test tests",
    "e2e": "node scripts/e2e.mjs",
    "e2e:install": "playwright install --with-deps chromium",
    "dev:demo": "node demo/prepare-assets.mjs && vite --config demo/vite.config.ts --port 5192 --strictPort",
    "build:demo": "node demo/prepare-assets.mjs && tsc --noEmit -p tsconfig.demo.json && vite build --config demo/vite.config.ts",
    "typecheck:demo": "tsc --noEmit -p tsconfig.demo.json",
    "test:demo": "bun test ./demo/demo.test.ts ./demo/demo-tryon.test.ts",
    "e2e:demo": "node demo/prepare-assets.mjs && node scripts/e2e-demo.mjs",
    "sync:site:demo": "node scripts/sync-site-demo.mjs",
    "review:record": "node scripts/review-journey.mjs",
    "compare:frontend": "node scripts/compare-with-frontend.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.62.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
