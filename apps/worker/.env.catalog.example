NODE_ENV=development
# Use only the role for the affiliate catalog. Provision it separately from the API and AI worker.
# STYLAI_CATALOG_WORKER_DATABASE_URL=postgresql://stylai_catalog_worker:SET_SECURELY@127.0.0.1:54322/postgres
# ALIEXPRESS_APP_KEY=
# ALIEXPRESS_APP_SECRET=
# ALIEXPRESS_TRACKING_ID=

# Set the same shared limits in the API and catalog worker. The worker's lower limits reserve headroom for Estúdio.
# ALIEXPRESS_CALLS_PER_MINUTE=
# ALIEXPRESS_CALLS_PER_DAY=
# STYLAI_CATALOG_CALLS_PER_MINUTE=
# STYLAI_CATALOG_CALLS_PER_DAY=

# Set both windows within the authorized storage terms. Refresh must be shorter than expiration.
# STYLAI_CATALOG_REFRESH_MINUTES=
# STYLAI_CATALOG_OFFER_TTL_MINUTES=
STYLAI_CATALOG_PAGE_SIZE=25
STYLAI_CATALOG_PAGES_PER_SEARCH=2
STYLAI_CATALOG_MAX_OFFERS=80
STYLAI_CATALOG_POLL_SECONDS=15

# Provider category IDs in searches are optional. Categories and prices in cents below filter normalized results.
STYLAI_CATALOG_COLLECTIONS=[{"slug":"linho-e-alfaiataria","label":"Linho e alfaiataria","searches":[{"keywords":"camisa de linho"},{"keywords":"calça de alfaiataria"}],"categories":["shirts","pants"]},{"slug":"malhas","label":"Malhas","searches":[{"keywords":"blusa de tricô"},{"keywords":"cardigan de tricô"}],"categories":["tops","jackets"]}]
